# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# PostgreSQL
#--------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=jioni_user
PG_PASSWORD=jioni_password
PG_DB_NAME=jioni

#--------------------------------------------------------------------
# Redis
#--------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

#--------------------------------------------------------------------
# MinIO / S3
#--------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=

DRIVE_DISK=fs

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

QUEUE_DRIVER=redis

APP_NAME=adonisjs_app
APP_VERSION=0.0.1
APP_ENV=development
REDIS_PASSWORD=
LIMITER_STORE=database

#--------------------------------------------------------------------
# Mail (Mailpit for local dev)
#--------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025

#--------------------------------------------------------------------
# Cookie Options
#--------------------------------------------------------------------
COOKIE_NAME=jioni_token
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_PATH=/
COOKIE_DOMAIN=localhost
COOKIE_MAX_AGE=2h
LOCK_STORE=database